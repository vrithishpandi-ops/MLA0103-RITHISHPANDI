        "\n",
        "# Candidate-Elimination Algorithm\n",
        "# Google Colab implementation using Pandas and Matplotlib\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "from io import BytesIO\n",
        "\n",
        "# Step 1: Create sample training data\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],\n",
        "    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],\n",
        "    'Forecast': ['Same', 'Same', 'Change', 'Change'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "df.to_csv('training_data.csv', index=False)\n",
        "\n",
        "# Step 2: Display and load CSV file\n",
        "print(\"Training Dataset:\")\n",
        "display(df)\n",
        "\n",
        "# To use your own CSV, uncomment the next lines:\n",
        "# uploaded = files.upload()\n",
        "# df = pd.read_csv(next(iter(uploaded)))\n",
        "\n",
        "target = 'EnjoySport'\n",
        "attributes = [col for col in df.columns if col != target]\n",
        "\n",
        "# Step 3: Initialize S and G\n",
        "n = len(attributes)\n",
        "S = ['Ø'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "def is_consistent(h, x):\n",
        "    return all(a == '?' or a == v for a, v in zip(h, x))\n",
        "\n",
        "def more_general_or_equal(h1, h2):\n",
        "    return all(a == '?' or a == b\n",
        "               for a, b in zip(h1, h2))\n",
        "\n",
        "def generalize_S(s, x):\n",
        "    result = s.copy()\n",
        "    for i in range(n):\n",
        "        if result[i] == 'Ø':\n",
        "            result[i] = x[i]\n",
        "        elif result[i] != x[i]:\n",
        "            result[i] = '?'\n",
        "    return result\n",
        "\n",
        "def specialize_G(g, x, domains):\n",
        "    result = []\n",
        "    for i in range(n):\n",
        "        if g[i] == '?':\n",
        "            for value in domains[i]:\n",
        "                if value != x[i]:\n",
        "                    h = g.copy()\n",
        "                    h[i] = value\n",
        "                    result.append(h)\n",
        "    return result\n",
        "\n",
        "# Attribute values from the CSV\n",
        "domains = [df[a].dropna().unique().tolist()\n",
        "           for a in attributes]\n",
        "\n",
        "# Step 4: Process training examples\n",
        "for index, row in df.iterrows():\n",
        "    x = [row[a] for a in attributes]\n",
        "    positive = str(row[target]).strip().lower() in [\n",
        "        'yes', 'yes.', 'true', '1'\n",
        "    ]\n",
        "\n",
        "    if positive:\n",
        "        # Remove hypotheses in G that do not cover x\n",
        "        G = [g for g in G if is_consistent(g, x)]\n",
        "\n",
        "        # Generalize S to cover the positive example\n",
        "        S = generalize_S(S, x)\n",
        "\n",
        "        # Keep S hypotheses no more general than any G hypothesis\n",
        "        G = [g for g in G if more_general_or_equal(g, S)]\n",
        "\n",
        "    else:\n",
        "        # Remove hypotheses in S that cover negative example\n",
        "        if is_consistent(S, x):\n",
        "            S = None\n",
        "\n",
        "        # Specialize G to exclude the negative example\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if is_consistent(g, x):\n",
        "                new_G.extend(specialize_G(g, x, domains))\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "\n",
        "        # Remove duplicates\n",
        "        G = [list(h) for h in {tuple(h) for h in new_G}]\n",
        "\n",
        "        # Remove hypotheses more specific than another G hypothesis\n",
        "        G = [\n",
        "            g for g in G\n",
        "            if not any(\n",
        "                g != other and more_general_or_equal(g, other)\n",
        "                for other in G\n",
        "            )\n",
        "        ]\n",
        "\n",
        "        # Remove hypotheses inconsistent with S\n",
        "        if S is not None:\n",
        "            G = [g for g in G if more_general_or_equal(g, S)]\n",
        "\n",
        "    print(f\"\\nExample {index + 1}: {x}\")\n",
        "    print(\"Class:\", \"Positive\" if positive else \"Negative\")\n",
        "    print(\"S boundary:\", S)\n",
        "    print(\"G boundary:\", G)\n",
        "\n",
        "# Step 5: Display final boundaries\n",
        "print(\"\\nFinal Specific Boundary (S):\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nFinal General Boundary (G):\")\n",
        "for g in G:\n",
        "    print(g)\n",
        "\n",
        "# Step 6: Visualize the boundaries using Matplotlib\n",
        "fig, ax = plt.subplots(figsize=(12, 5))\n",
        "\n",
        "ax.axis('off')\n",
        "ax.set_title('Candidate-Elimination Algorithm', fontsize=16)\n",
        "\n",
        "ax.text(0.02, 0.85, \"Specific Boundary (S)\",\n",
        "        fontsize=12, fontweight='bold')\n",
        "ax.text(0.02, 0.70, str(S), fontsize=10, wrap=True)\n",
        "\n",
        "ax.text(0.02, 0.48, \"General Boundary (G)\",\n",
        "        fontsize=12, fontweight='bold')\n",
        "\n",
        "g_text = \"\\n\".join(str(g) for g in G) if G else \"Empty set\"\n",
        "ax.text(0.02, 0.30, g_text, fontsize=10, wrap=True)\n",
        "\n",
        "ax.text(0.02, 0.08,\n",
        "        \"Ø = most specific | ? = any value\",\n",
        "        fontsize=10)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    }
